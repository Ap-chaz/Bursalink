PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=bursalink_db

# Authentication Secrets (REQUIRED in production: min 32 random chars)
AUTH_SECRET=replace_with_at_least_32_random_characters_in_production
PASSWORD_PEPPER=replace_with_distinct_32_random_characters_in_production
BCRYPT_COST=12

# Allowed CORS origins (comma-separated in production)
ALLOWED_ORIGINS=http://localhost:5173

# Provisioned administrative staff emails excluded from public student sign-up
ADMIN_EMAILS=admin@bursalink.org

# Brevo Transactional Email Configuration (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BursaLink Kenya
